@inherits LayoutComponentBase

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <span class="admin-logo">💌</span>
            <span class="admin-brand">Grajfka</span>
            <span class="admin-badge">Admin</span>
        </div>
        <nav class="admin-nav">
            <NavLink href="/admin" class="admin-nav-link" Match="NavLinkMatch.All">
                <span class="admin-nav-icon">📊</span>
                <span>Dashboard</span>
            </NavLink>
            <NavLink href="/admin/products" class="admin-nav-link">
                <span class="admin-nav-icon">📦</span>
                <span>Produkty</span>
            </NavLink>
            <NavLink href="/admin/categories" class="admin-nav-link">
                <span class="admin-nav-icon">🏷️</span>
                <span>Kategorie</span>
            </NavLink>
            <NavLink href="/admin/orders" class="admin-nav-link">
                <span class="admin-nav-icon">🛒</span>
                <span>Zamówienia</span>
            </NavLink>
        </nav>
        <div class="admin-sidebar-footer">
            <a href="/" class="admin-nav-link">
                <span class="admin-nav-icon">🏠</span>
                <span>Wróć do sklepu</span>
            </a>
        </div>
    </aside>
    <main class="admin-main">
        <div class="admin-content">
            @Body
        </div>
    </main>
</div>
