@page "/"

<PageTitle>GRAJFKA - Biżuteria, Zaproszenia i nie tylko!</PageTitle>

<section id="home" class="hero">
    <div class="hero-content">
        <h1 class="hero-title">
            Biżuteria i <br>
            <span class="gradient-text">Zaproszenia</span><br>
            na Każdą Okazję
        </h1>
        <p class="hero-description">
            Oferujemy wyjątkową biżuterię – bransoletki, kolczyki i naszyjniki – oraz piękne zaproszenia i kartki na wesela, urodziny i chrzciny. Każdy produkt tworzony jest z pasją, aby podkreślić wyjątkowy charakter Twojej uroczystości.
        </p>
        <div class="hero-buttons">
            @*<button class="btn-primary" @onclick="ScrollToProducts">Zobacz Ofertę</button>*@
            <button class="btn-secondary">Zamów projekt</button>
        </div>
    </div>
    <div class="hero-visual">
        <div class="hero-circle">
            <div class="hero-icon">💌</div>
        </div>
        <div class="floating-element-1"></div>
        <div class="floating-element-2"></div>
    </div>
</section>

<!-- Products Section -->
<section id="products" class="products-section">
    <div class="section-header">
        <h2 class="section-title">Nasze Bestsellery</h2>
        <p class="section-description">
            Najpopularniejsze zaproszenia i dodatki wybierane przez naszych klientów
        </p>
    </div>
    <div class="products-grid">
        @foreach (var product in products)
        {
            <div class="product-card">
                <div class="product-image">
                    <div class="product-icon">@product.Icon</div>
                    <div class="heart-icon">❤️</div>
                </div>
                <div class="product-info">
                    <h3 class="product-name">@product.Name</h3>
                    <p class="product-description">@product.Description</p>
                    <div class="product-footer">
                        <span class="product-price">@product.Price.ToString("F2") zł</span>
                        <button class="add-to-cart" @onclick="() => AddToCart(product.Id)">
                            Dodaj do koszyka
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Collections Section -->
<section id="collections" class="collections-section">
    <div class="section-header">
        <h2 class="section-title">Kategorie Produktów</h2>
        <p class="section-description">Znajdź idealne rozwiązanie na każdą uroczystość</p>
    </div>
    <div class="collections-grid">
        <div class="collection-card">
            <div class="collection-bg wedding">
                <div class="collection-icon">💒</div>
            </div>
            <div class="collection-overlay"></div>
            <div class="collection-content">
                <h3 class="collection-title">Wesela & Śluby</h3>
                <p class="collection-description">Eleganckie zaproszenia ślubne, dodatki weselne i biżuteria dla Pary Młodej</p>
                <button class="collection-btn">Zobacz produkty</button>
            </div>
        </div>
        <div class="collection-card">
            <div class="collection-bg birthday">
                <div class="collection-icon">🎂</div>
            </div>
            <div class="collection-overlay"></div>
            <div class="collection-content">
                <h3 class="collection-title">Urodziny</h3>
                <p class="collection-description">Kolorowe kartki urodzinowe, zaproszenia na party i dodatki świąteczne</p>
                <button class="collection-btn">Zobacz produkty</button>
            </div>
        </div>
        <div class="collection-card">
            <div class="collection-bg baptism">
                <div class="collection-icon">👼</div>
            </div>
            <div class="collection-overlay"></div>
            <div class="collection-content">
                <h3 class="collection-title">Chrzciny</h3>
                <p class="collection-description">Delikatne zaproszenia na chrzciny, pamiątki i biżuteria dla dzieci</p>
                <button class="collection-btn">Zobacz produkty</button>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
