@page "/admin/products"
@layout BlazorApp.Components.Layout.AdminLayout
@rendermode InteractiveServer
@using Application.Requests.Queries.Products.GetAllProducts
@using Application.Requests.Queries.Products.Models
@using Application.Requests.Commands.Products.Delete
@inject MediatR.IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Panel Admina - Produkty</PageTitle>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Produkty</h1>
        <p class="admin-page-subtitle">Zarządzaj produktami w sklepie</p>
    </div>
    <a href="/admin/products/add" class="admin-btn admin-btn-primary">➕ Dodaj produkt</a>
</div>

@if (alertMessage != null)
{
    <div class="admin-alert @(alertIsError ? "admin-alert-danger" : "admin-alert-success")">@alertMessage</div>
}

@if (products == null)
{
    <div class="admin-loading"><div class="admin-spinner"></div> Ładowanie produktów...</div>
}
else
{
    <div class="admin-card">
        <table class="admin-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Nazwa</th>
                    <th>Kategoria</th>
                    <th>Cena</th>
                    <th>Status</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (!products.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="admin-empty">
                                <div class="admin-empty-icon">📦</div>
                                <p>Brak produktów. Dodaj pierwszy!</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var product in products)
                {
                    <tr>
                        <td>
                            @if (product.ImageUrls.Any())
                            {
                                <img src="@product.ImageUrls.First()" alt="" class="admin-product-thumb"/>
                            }
                            else
                            {
                                <div class="admin-product-thumb-placeholder">📷</div>
                            }
                        </td>
                        <td><strong>@product.Name</strong></td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("N2") zł</td>
                        <td>
                            <span class="admin-badge-status @(product.IsActive ? "badge-active" : "badge-inactive")">
                                @(product.IsActive ? "Aktywny" : "Nieaktywny")
                            </span>
                        </td>
                        <td>
                            <a href="/admin/products/edit/@product.Id" class="admin-btn admin-btn-outline admin-btn-sm">✏️ Edytuj</a>
                            <button class="admin-btn admin-btn-danger admin-btn-sm" @onclick="() => ConfirmDelete(product)">🗑️ Usuń</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (productToDelete != null)
{
    <div class="admin-modal-backdrop" @onclick="CancelDelete">
        <div class="admin-modal" @onclick:stopPropagation>
            <div class="admin-modal-header">
                <h3 class="admin-modal-title">Potwierdzenie usunięcia</h3>
                <button class="admin-modal-close" @onclick="CancelDelete">✕</button>
            </div>
            <div class="admin-modal-body">
                <p>Czy na pewno chcesz usunąć produkt <strong>@productToDelete.Name</strong>?</p>
                <p style="color: var(--admin-text-muted); font-size: 0.85rem;">Ta operacja jest nieodwracalna.</p>
            </div>
            <div class="admin-modal-footer">
                <button class="admin-btn admin-btn-outline" @onclick="CancelDelete">Anuluj</button>
                <button class="admin-btn admin-btn-danger" @onclick="DeleteProduct" style="background: var(--admin-danger); color: white;">Usuń</button>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<ProductDto>? products;
    private ProductDto? productToDelete;
    private string? alertMessage;
    private bool alertIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        var result = await Mediator.Send(new GetAllProductsQuery { ActiveOnly = false });
        products = result.Products;
    }

    private void ConfirmDelete(ProductDto product)
    {
        productToDelete = product;
    }

    private void CancelDelete()
    {
        productToDelete = null;
    }

    private async Task DeleteProduct()
    {
        if (productToDelete == null) return;
        try
        {
            await Mediator.Send(new DeleteProductCommand { Id = productToDelete.Id });
            alertMessage = $"Produkt \"{productToDelete.Name}\" został usunięty.";
            alertIsError = false;
            productToDelete = null;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            alertMessage = $"Błąd: {ex.Message}";
            alertIsError = true;
            productToDelete = null;
        }
    }
}
