@if (showNotification)
{
    <div class="notification show">
        @notificationMessage
    </div>
}

@code {
    private int cartCount = 0;
    private bool showNotification = false;
    private string notificationMessage = "";
    private Timer? notificationTimer;

    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Price { get; set; }
        public string Icon { get; set; } = "";
    }

    private readonly List<Product> products = new()
    {
        new Product { Id = 1, Name = "Zaproszenia Ślubne Elegance", Description = "Klasyczne zaproszenia z koronkowym wykończeniem", Price = 8.50m, Icon = "💌" },
        new Product { Id = 2, Name = "Kartki Urodzinowe Floral", Description = "Kolorowe kartki z motywem kwiatowym", Price = 4.20m, Icon = "🎂" },
        new Product { Id = 3, Name = "Zaproszenia na Chrzciny", Description = "Delikatne zaproszenia z motywem anielskim", Price = 6.80m, Icon = "👼" },
        new Product { Id = 4, Name = "Bransoletka dla Panny Młodej", Description = "Elegancka bransoletka z perłami", Price = 150.00m, Icon = "💫" },
        new Product { Id = 5, Name = "Kolczyki Ślubne", Description = "Delikatne kolczyki z kryształkami", Price = 85.00m, Icon = "💎" },
        new Product { Id = 6, Name = "Menu Weselne Premium", Description = "Ekskluzywne menu z ozdobnym wykończeniem", Price = 12.00m, Icon = "🍽️" },
        new Product { Id = 7, Name = "Winietki Personalizowane", Description = "Eleganckie winietki z imionami gości", Price = 3.50m, Icon = "🏷️" },
        new Product { Id = 8, Name = "Pudełko na Koperty", Description = "Piękne pudełko na koperty ślubne", Price = 45.00m, Icon = "📦" }
    };

    private void AddToCart(int productId)
    {
        cartCount++;
        var product = products.FirstOrDefault(p => p.Id == productId);
        ShowNotification($"Dodano {product?.Name} do koszyka!");
        StateHasChanged();
    }

    private void ShowCart()
    {
        ShowNotification($"Koszyk zawiera {cartCount} produktów");
    }

    private async void ShowNotification(string message)
    {
        notificationMessage = message;
        showNotification = true;
        StateHasChanged();

        // Ukryj notyfikację po 3 sekundach
        notificationTimer?.Dispose();
        notificationTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                showNotification = false;
                StateHasChanged();
            });
        }, null, 3000, Timeout.Infinite);
    }

    public void Dispose()
    {
        notificationTimer?.Dispose();
    }
}