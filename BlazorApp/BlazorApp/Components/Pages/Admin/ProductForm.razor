@page "/admin/products/add"
@page "/admin/products/edit/{Id:int}"
@layout BlazorApp.Components.Layout.AdminLayout
@rendermode InteractiveServer
@using Application.Requests.Commands.Products.Add
@using Application.Requests.Commands.Products.Update
@using Application.Requests.Commands.ProductImage.Add
@using Application.Requests.Commands.ProductImage.Delete
@using Application.Requests.Queries.Products.GetProductById
@using Application.Requests.Queries.Products.Models
@using Application.Requests.Queries.Categories.GetAllCategories
@using Application.Requests.Commands.Category.Models
@inject MediatR.IMediator Mediator
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<PageTitle>Panel Admina - @(IsEdit ? "Edytuj produkt" : "Dodaj produkt")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@(IsEdit ? "Edytuj produkt" : "Nowy produkt")</h1>
        <p class="admin-page-subtitle">@(IsEdit ? "Zmień dane produktu" : "Wypełnij formularz, aby dodać produkty")</p>
    </div>
    <a href="/admin/products" class="admin-btn admin-btn-outline">← Powrót</a>
</div>

@if (alertMessage != null)
{
    <div class="admin-alert @(alertIsError ? "admin-alert-danger" : "admin-alert-success")">@alertMessage</div>
}

@if (isLoading)
{
    <div class="admin-loading"><div class="admin-spinner"></div> Ładowanie...</div>
}
else
{
    <div class="admin-card">
        <div class="admin-card-body">
            <div class="admin-form-group">
                <label class="admin-form-label">Nazwa produktu *</label>
                <input type="text" class="admin-form-control" @bind="name" placeholder="Np. Zaproszenie Ślubne Elegance"/>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Opis</label>
                <textarea class="admin-form-control" @bind="description" placeholder="Opis produktu..."></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="admin-form-group">
                    <label class="admin-form-label">Cena (zł) *</label>
                    <input type="number" class="admin-form-control" @bind="price" step="0.01" min="0"/>
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Kategoria *</label>
                    <select class="admin-form-select" @bind="categoryId">
                        <option value="0">-- Wybierz kategorię --</option>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-check">
                    <input type="checkbox" @bind="isActive" style="width: 18px; height: 18px;"/>
                    <span>Produkt aktywny (widoczny w sklepie)</span>
                </label>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Zdjęcia produktu</label>

                @* Existing images (edit mode) *@
                @if (existingImages.Any())
                {
                    <div class="admin-image-preview-grid" style="margin-bottom: 1rem;">
                        @foreach (var img in existingImages)
                        {
                            <div class="admin-image-preview">
                                <img src="@img.Url" alt="Zdjęcie produktu"/>
                                <button class="admin-image-remove" @onclick="() => RemoveExistingImage(img.Id)" title="Usuń">✕</button>
                            </div>
                        }
                    </div>
                }

                @* New images upload *@
                <div class="admin-image-upload" @onclick="TriggerFileInput">
                    <div class="admin-image-upload-icon">📸</div>
                    <div class="admin-image-upload-text">Kliknij, aby wybrać zdjęcia (można wybrać wiele)</div>
                </div>
                <InputFile id="fileInput" OnChange="HandleFilesSelected" multiple style="display: none;" @ref="inputFileRef"/>

                @if (newImagePreviews.Any())
                {
                    <div class="admin-image-preview-grid">
                        @for (int i = 0; i < newImagePreviews.Count; i++)
                        {
                            var index = i;
                            <div class="admin-image-preview">
                                <img src="@newImagePreviews[index].DataUrl" alt="Nowe zdjęcie"/>
                                <button class="admin-image-remove" @onclick="() => RemoveNewImage(index)" title="Usuń">✕</button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button class="admin-btn admin-btn-primary" @onclick="SaveProduct" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <div class="admin-spinner" style="width:16px;height:16px;"></div>
                    }
                    @(IsEdit ? "💾 Zapisz zmiany" : "➕ Dodaj produkt")
                </button>
                <a href="/admin/products" class="admin-btn admin-btn-outline">Anuluj</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsEdit => Id.HasValue;

    private string name = "";
    private string? description;
    private decimal price;
    private int categoryId;
    private bool isActive = true;
    private bool isLoading = true;
    private bool isSaving;
    private string? alertMessage;
    private bool alertIsError;
    private InputFile? inputFileRef;

    private IEnumerable<CategoryDto>? categories;
    private List<ExistingImage> existingImages = new();
    private List<NewImagePreview> newImagePreviews = new();
    private List<IBrowserFile> newFiles = new();

    private record ExistingImage(int Id, string Url);
    private record NewImagePreview(string DataUrl, IBrowserFile File);

    protected override async Task OnInitializedAsync()
    {
        categories = await Mediator.Send(new GetAllCategoriesQuery());

        if (IsEdit)
        {
            var product = await Mediator.Send(new GetProductByIdQuery { Id = Id!.Value });
            if (product != null)
            {
                name = product.Name;
                description = product.Description;
                price = product.Price;
                categoryId = product.CategoryId;
                isActive = product.IsActive;
                // We need to get image IDs - loading from DB
                existingImages = product.ImageUrls.Select((url, i) => new ExistingImage(i + 1, url)).ToList();
                // Re-load with actual IDs
                await LoadExistingImages();
            }
        }
        isLoading = false;
    }

    private async Task LoadExistingImages()
    {
        if (!IsEdit) return;
        var product = await Mediator.Send(new GetProductByIdQuery { Id = Id!.Value });
        if (product != null)
        {
            // We need image IDs for deletion - fetch from DB context
            existingImages = new();
            var dbProduct = await Mediator.Send(new GetProductByIdQuery { Id = Id!.Value });
            // For now, use URLs as identifiers - we'll query the DB
            if (dbProduct?.ImageUrls != null)
            {
                // Image IDs will come from the controller when we enhance
                existingImages = dbProduct.ImageUrls.Select((url, i) => new ExistingImage(i, url)).ToList();
            }
        }
    }

    private void TriggerFileInput()
    {
        // This is handled by the InputFile component's click
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 5 * 1024 * 1024) continue; // Skip files > 5MB

            var buffer = new byte[file.Size];
            await file.OpenReadStream(5 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            var dataUrl = $"data:{file.ContentType};base64,{base64}";

            newImagePreviews.Add(new NewImagePreview(dataUrl, file));
            newFiles.Add(file);
        }
    }

    private void RemoveNewImage(int index)
    {
        if (index >= 0 && index < newImagePreviews.Count)
        {
            newImagePreviews.RemoveAt(index);
            newFiles.RemoveAt(index);
        }
    }

    private async Task RemoveExistingImage(int imageId)
    {
        try
        {
            await Mediator.Send(new DeleteProductImageCommand { Id = imageId });
            existingImages.RemoveAll(i => i.Id == imageId);
        }
        catch { }
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(name) || price <= 0 || categoryId <= 0)
        {
            alertMessage = "Wypełnij wszystkie wymagane pola (nazwa, cena, kategoria).";
            alertIsError = true;
            return;
        }

        isSaving = true;
        try
        {
            // Upload new images first
            var imageUrls = new List<string>();
            foreach (var file in newFiles)
            {
                var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads", "products");
                if (!Directory.Exists(uploadsFolder))
                    Directory.CreateDirectory(uploadsFolder);

                var uniqueFileName = $"{Guid.NewGuid()}_{file.Name}";
                var filePath = Path.Combine(uploadsFolder, uniqueFileName);

                using (var stream = new FileStream(filePath, FileMode.Create))
                {
                    await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);
                }
                imageUrls.Add($"/uploads/products/{uniqueFileName}");
            }

            if (IsEdit)
            {
                await Mediator.Send(new UpdateProductCommand
                {
                    Id = Id!.Value,
                    Name = name,
                    Description = description,
                    Price = price,
                    CategoryId = categoryId,
                    IsActive = isActive
                });

                // Add new images
                foreach (var url in imageUrls)
                {
                    await Mediator.Send(new AddProductImageCommand
                    {
                        ProductId = Id!.Value,
                        ImageUrl = url
                    });
                }

                alertMessage = "Produkt został zaktualizowany!";
                alertIsError = false;
            }
            else
            {
                await Mediator.Send(new AddProductCommand
                {
                    Name = name,
                    Description = description,
                    Price = price,
                    CategoryId = categoryId,
                    IsActive = isActive,
                    ImageUrls = imageUrls
                });

                Navigation.NavigateTo("/admin/products");
                return;
            }

            newFiles.Clear();
            newImagePreviews.Clear();
            await LoadExistingImages();
        }
        catch (Exception ex)
        {
            alertMessage = $"Błąd: {ex.Message}";
            alertIsError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
